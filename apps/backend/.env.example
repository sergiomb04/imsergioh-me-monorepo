# ===============================================
# Backend Environment Configuration Template
# ===============================================

# Server Port
PORT=8081

# MariaDB / MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=analytics
DB_USER=root
DB_PASSWORD=root

# Security Secrets (Must match Frontend ADMIN_SESSION_SECRET in production)
ADMIN_SESSION_SECRET=change_this_to_a_secure_random_admin_session_secret

# CORS Allowed Origins (Comma-separated list or * for development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://imsergioh.me

# Storage Root for CDN files
CDN_ROOT=data/cdn

# MaxMind GeoLite2 MMDB path (optional)
GEOIP_DB_PATH=data/GeoLite2-Country.mmdb

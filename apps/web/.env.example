# ==========================================
# Autenticación (NextAuth / Auth.js)
# ==========================================
# Credenciales OAuth 2.0 de Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Clave secreta para cifrado de tokens JWT y firmas HMAC (genera una cadena aleatoria y segura)
# openssl rand -base64 32
NEXT_AUTH_SECRET=your-random-32-byte-secret
AUTH_SECRET=
ADMIN_SESSION_SECRET=change_in_production_secret

# Lista blanca de correos de Google autorizados para acceder al panel de administración (/admin)
# Separados por comas sin espacios
ALLOWED_EMAILS=admin@yourdomain.com,developer@yourdomain.com

# ==========================================
# URLs de Sitio y Backend (Producción / Dev)
# ==========================================
# URL canónica pública del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Backend LiveState (WebSockets y API REST)
NEXT_PUBLIC_LIVESTATE_URL=https://livestate.imsergioh.me
BACKEND_API_URL=https://livestate.imsergioh.me

# CDN y Gestión de Archivos
NEXT_PUBLIC_CDN_API_URL=https://livestate.imsergioh.me/api/cdn
BACKEND_CDN_API_URL=https://livestate.imsergioh.me/api/cdn

# Acortador de Enlaces y Tráfico
BACKEND_LINKS_API_URL=https://livestate.imsergioh.me/api/links
BACKEND_LINKS_DATA_API_URL=https://livestate.imsergioh.me/api/links-data

# Servidor WebSocket para el Chat interactivo
NEXT_PUBLIC_CHAT_WS_URL=wss://chat.imsergioh.me

# ==========================================
# Configuración Opcional de Desarrollo
# ==========================================
# Orígenes permitidos adicionales para depuración en red local (ej. 192.168.1.50)
ALLOWED_DEV_ORIGINS=